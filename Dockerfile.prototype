# Prototype runner container for link-prediction (Zenodo 10548434)
# Uses Python 3.10 to satisfy torch/torch_geometric requirements.

FROM python:3.10-slim

WORKDIR /app

# System deps for torch/torch_geometric wheels
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy only prototype code and requirements to keep image small
COPY data/prototype/link-prediction ./link-prediction

WORKDIR /app/link-prediction

RUN pip install --no-cache-dir -r requirements.txt

# Default command prints help; override to run scripts/prototype_runner.py via docker run
CMD ["python", "-c", "print('Prototype image ready; run with scripts/prototype_runner.py mounted data/raw/cyber_czech/data.json')"]
